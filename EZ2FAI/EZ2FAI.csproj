<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>EZ2FAI</RootNamespace>
		<AssemblyName>EZ2FAI</AssemblyName>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<OutputPath>..\Build\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
		<NoStdLib>true</NoStdLib>
		<!-- Game install folder used by the optional PostBuild deploy step.
		     Override per machine, e.g.  dotnet build -p:GamePath="D:\...\A Dance of Fire and Ice".
		     The copy is skipped when the Mods folder is absent, so CI / other setups never fail. -->
		<GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice</GamePath>
		<!-- Game Managed folder containing the reference DLLs. Defaults to the local
		     install; CI overrides it with -p:ManagedDir=... pointing at the checked-out
		     game libs, so the build is portable and works on a fresh runner. -->
		<ManagedDir Condition="'$(ManagedDir)' == ''">..\..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice\A Dance of Fire and Ice_Data\Managed</ManagedDir>
	</PropertyGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="Exists('$(GamePath)\Mods\EZ2FAI')">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods\EZ2FAI\" />
	</Target>

